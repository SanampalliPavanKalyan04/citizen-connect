SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-another-long-random-string
# SQLite for local; use Postgres in production, e.g.
# DATABASE_URL=postgresql://user:pass@host:5432/citizen_connect
DATABASE_URL=sqlite:///citizen_connect.db
# Your real admin account (created on first start)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true = create public demo accounts (admin123 etc). Set false in production.
SEED_DEMO=true
FLASK_DEBUG=false
